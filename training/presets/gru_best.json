{
  "name": "gru_best",
  "dataset_dir": "data/training",
  "output_dir": "training/runs",
  "train_script": "training/train.py",
  "objective": {
    "split": "val",
    "metric": "r2",
    "direction": "max"
  },
  "base_args": {
    "run_name": "gru_best",
    "models": ["gru"],
    "target_mode": "raw",
    "latent_state_dim": 3,
    "physics_loss": "combined",
    "physics_config": "training/physics_weights.json",
    "max_epochs": 120,
    "patience": 20,
    "batch_size": 64,
    "dropout": 0.05,
    "learning_rate": 0.001,
    "weight_decay": 0.00005,
    "physics_weight": 0.03,
    "physics_warmup_epochs": 10,
    "hidden_size": 96
  },
  "jobs": [
    {
      "name": "gru",
      "models": ["gru"]
    }
  ]
}
