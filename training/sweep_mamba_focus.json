{
  "name": "mamba_focus",
  "dataset_dir": "data/training",
  "output_dir": "training/sweeps/mamba_focus",
  "train_script": "training/train.py",
  "objective": {
    "split": "val",
    "metric": "r2",
    "direction": "max"
  },
  "base_args": {
    "target_mode": "raw",
    "latent_state_dim": 3,
    "physics_loss": "combined",
    "physics_config": "training/physics_weights.json",
    "max_epochs": 120,
    "patience": 20,
    "batch_size": 64,
    "dropout": 0.0,
    "physics_warmup_epochs": 10
  },
  "jobs": [
    {
      "name": "tiny_mamba_ssm",
      "models": ["tiny_mamba_ssm"],
      "grid": {
        "hidden_size": [96, 128],
        "learning_rate": [0.001, 0.0005],
        "weight_decay": [0.00005, 0.00001],
        "physics_weight": [0.01, 0.03]
      }
    }
  ]
}
